# Copy to backend/.env (gitignored) and fill in real values.
# Never commit backend/.env.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/migueldev_blog

# Generate with: python scripts/hash_password.py "your-password"
# docker-compose interpolates $ in env_file values — escape every $ as $$
# (bcrypt hashes always start with $2b$ etc, so this always applies here).
ADMIN_PASSWORD_HASH=

# Any long random string. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

PORT=8000
